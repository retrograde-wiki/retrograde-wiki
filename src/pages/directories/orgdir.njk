---
layout: layouts/gallerypage.njk
eleventyExcludeFromCollections: true
orgtypes:
  - id: institutes
    title: Institutes
    subtitle: Research, education and study
  - id: networks
    title: Networks
    subtitle: Media, communication and information
  - id: companies
    title: Companies
    subtitle: Businesses beneath the Monoliths
pagination:
  data: orgtypes
  size: 1
  alias: orgtype
permalink: "/{{ orgtype.id }}.html"
eleventyComputed:
  title: "{{ orgtype.title }}"
  subtitle: "{{ orgtype.subtitle }}"
---

<div class="mono-list">
{% for item in collections[orgtype.id] | sort(attribute="data.title") %}
  {% if item.url and not item.data.hidden %}
  <a class="mono-row no-num" href="{{ item.url }}">
    <div class="mono-row-logo">
      {% if item.data.logo %}<img src="{{ item.data.logo }}" alt="" loading="lazy">{% endif %}
    </div>
    <div class="mono-row-main">
      <div class="mono-row-title">{{ item.data.title }}</div>
      {% if item.data.description %}<p class="mono-row-desc">{{ item.data.description }}</p>{% endif %}
    </div>
    <div class="mono-row-meta">
      {% if item.data.industry %}<div>{{ item.data.industry }}</div>{% endif %}
      {% if item.data.zone %}<div>{{ item.data.zone }}</div>{% endif %}
    </div>
  </a>
  {% endif %}
{% endfor %}
</div>
