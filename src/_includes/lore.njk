<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <link rel="stylesheet" href="/style/style.css">
  <link rel="stylesheet" href="/style/root.css">
  <link rel="icon" href="https://file.garden/aBb6prPw8QkQxICV/website/placeholder/Logo" />
  <script src="/style/hover.js"></script>
  <title>RETROGRADE - {{ title | upper }}</title>
</head>

<body>
  <div id="header-placeholder"></div>
  <script src="/header.js"></script>

  <div class="lore-container">
    <div class="lore-header">
      <h1 class="lore-title">{{ title }}</h1>
      {% if subtitle %}<p class="intro-subtitle">{{ subtitle }}</p>{% endif %}
    </div>

    <div class="lore-section">
      {{ content | safe }}
    </div>
  </div>
</body>
</html>
